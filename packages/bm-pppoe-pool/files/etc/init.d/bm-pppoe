#!/bin/sh /etc/rc.common

# After the network, because the first thing it does is ask netifd what exists.
# Before bm-wanbind, because a binding instance hands clients to the WANs this
# package dials, and a pool that is already being watched when the binder starts
# is one fewer thirty-second gap after every reboot.
START=96
STOP=12

USE_PROCD=1

DAEMON="/usr/share/bm/pppoed.uc"

start_service() {
	# The schema gate, here rather than only inside the daemon.
	#
	# The daemon refuses to run against data written by a newer release and
	# exits saying so. That refusal is correct, but procd does not look at the
	# exit status - the third respawn field is a retry limit and it is 0, which
	# means unlimited - so an instance registered here is restarted every five
	# seconds forever, and the one line that explains why fills the log instead
	# of standing in it.
	#
	# `bmctl schema` is the same check the daemon makes, run before anything is
	# registered. A router in that state then has no instance to respawn, one
	# line in the log, and a service that starts normally as soon as the right
	# release is back.
	if ! /usr/sbin/bmctl schema >/dev/null 2>&1; then
		logger -t bm-pppoe -p daemon.err "the data on disk is written at a schema this build does not understand; not starting - run 'bmctl schema' to see why"
		return 0
	fi

	procd_open_instance bm-pppoe
	# Raw script, strict mode, said out loud rather than left to a shebang.
	procd_set_param command /usr/bin/ucode -R -S "$DAEMON"
	# Unlimited restarts, five seconds apart. Nothing breaks when this is not
	# running - netifd keeps dialling - but nothing is watching either, and a
	# service that stops being retried is one nobody notices has gone.
	procd_set_param respawn 3600 5 0
	# procd forwards stderr to syslog, which is where every notice() ends up.
	procd_set_param stderr 1
	# procd restarts the instance when this file's contents change, which is how
	# an edit takes effect. It is also why nothing in the daemon re-reads its
	# own settings: there is no half-reloaded state to get wrong.
	procd_set_param file /etc/config/bm_pppoe
	procd_close_instance
}

# Deliberately no stop hook.
#
# bm-wanbind removes its ip rules when it stops, because rules with nothing
# maintaining them are worse than no rules. This package installs nothing of
# that kind: the sections it wrote are ordinary `config interface` entries that
# netifd dials on its own, and taking them away because a watcher stopped would
# turn "the service restarted" into "every session on this router dropped".
#
# Stopping this means nothing is watching. It does not mean anything is off.

service_triggers() {
	procd_add_reload_trigger "bm_pppoe"
}
