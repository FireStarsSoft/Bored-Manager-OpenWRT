#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:941
msgid "Redial after (s)"
msgstr "Quay số lại sau (giây)"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:459
msgid "Redial all"
msgstr "Quay số lại tất cả"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:459
