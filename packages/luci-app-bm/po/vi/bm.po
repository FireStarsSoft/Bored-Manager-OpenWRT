msgstr "Mã pool"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:284
msgid "Pools"
msgstr "Số nhóm"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:400
