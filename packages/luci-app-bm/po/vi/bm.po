msgid "%s is not in /etc/config/bm_wanbind as this login can read it, so it cannot be edited from here."
msgstr "%s không có trong /etc/config/bm_wanbind theo những gì phiên đăng nhập này đọc được, nên không sửa được từ đây."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:680
msgid "%s is pinned to %s."
msgstr "%s đã được ghim vào %s."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:445
msgid "...and %d more."
msgstr "...và %d dòng nữa."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:507
msgid "0 for none. A VLAN device is created for it if one is needed."
msgstr "0 là không dùng. Thiết bị VLAN sẽ được tạo nếu cần."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:505
msgid "1 to 4 characters, starting with a letter. Sessions are named prefix00001 upwards."
msgstr "1 đến 4 ký tự, bắt đầu bằng chữ cái. Phiên được đặt tên prefix00001 trở lên."

#: packages/luci-app-bm/htdocs/luci-static/resources/bm/api.js:360
msgid "A change is waiting to be confirmed"
msgstr "Một thay đổi đang chờ được xác nhận"

