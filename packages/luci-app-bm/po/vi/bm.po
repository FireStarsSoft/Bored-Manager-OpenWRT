msgstr "Thêm một instance"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:580
msgid "Add it"
msgstr "Thêm"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:632
msgid "Add sessions"
msgstr "Thêm phiên"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:574
msgid "Add sessions to %s"
msgstr "Thêm phiên vào %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:571
msgid "Add them"
msgstr "Thêm chúng"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:576
msgid "Adding here rather than creating a second pool with the same prefix is the point: a second pool whose numbering overlaps would quietly rewrite this one's credentials, and the router refuses it for that reason."
msgstr "Thêm ở đây thay vì tạo một nhóm thứ hai cùng tiền tố chính là điểm mấu chốt: một nhóm thứ hai có dải số chồng lấn sẽ lặng lẽ ghi đè thông tin tài khoản của nhóm này, và router từ chối vì lẽ đó."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:175
msgid "Agent"
msgstr "Agent"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:25
msgid "Arm the countdown and take a snapshot"
msgstr "Bật đồng hồ đếm ngược và chụp một bản lưu"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:29
