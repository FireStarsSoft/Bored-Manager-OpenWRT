msgstr "Xoá instance %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:684
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:406
msgid "Delete it"
msgstr "Xoá nó"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:665
msgid "Delete pool %s"
msgstr "Xoá nhóm %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:130
msgid "Delete the snapshot taken at %s? There is no way back to it afterwards."
msgstr "Xoá bản lưu chụp lúc %s? Sau đó không còn đường quay lại nó."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:134
msgid "Deleted."
msgstr "Đã xoá."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:209
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:598
msgid "Dialing"
msgstr "Đang quay số"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:599
msgid "Down"
msgstr "Đã tắt"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:123
msgid "Download"
msgstr "Tải về"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:27
msgid "Download each archive and check its sha256 against the manifest"
msgstr "Tải từng gói và đối chiếu sha256 với manifest"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:509
msgid "Each session gets its own table, counting up from here."
msgstr "Mỗi phiên có bảng định tuyến riêng, đếm lên từ đây."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:100
msgid "Each step is written to the system log as it happens. At a console: \"logread -e bm-agent\", or \"bmctl version\" for what this router answers now."
msgstr "Mỗi bước được ghi vào nhật ký hệ thống ngay khi xảy ra. Ở console: \"logread -e bm-agent\", hoặc \"bmctl version\" để xem router đang trả lời phiên bản nào."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:259
msgid "Edit"
msgstr "Sửa"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:556
msgid "Edit instance %s"
msgstr "Sửa instance %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:599
msgid "Error"
msgstr "Lỗi"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:194
msgid "Every client on the LAN gets a WAN of its own, decided here on the router the moment its lease arrives."
msgstr "Mỗi máy trong LAN có một WAN riêng, được quyết định ngay tại router vào lúc lease của nó tới."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:365
msgid "Every client this instance was binding goes back to being routed the way the rest of the router routes, and its fail-closed catch-all goes with it."
msgstr "Mọi máy khách instance này đang gán sẽ quay về đi theo cách định tuyến chung của router, và luật chặn dự phòng của nó cũng mất theo."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:500
msgid "Every number on this form has to be a whole number."
msgstr "Mọi con số trên biểu mẫu này phải là số nguyên."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:764
msgid "Every session is up."
msgstr "Mọi phiên đều đang lên."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:97
msgid "Every step in order. A step that fails stops the ones after it, and the countdown puts the router back if nobody confirms."
msgstr "Từng bước theo thứ tự. Một bước hỏng sẽ dừng những bước sau, và đồng hồ đếm ngược đưa router về như cũ nếu không ai xác nhận."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:48
msgid "Everything"
msgstr "Tất cả"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:568
msgid "Failure grace"
msgstr "Thời gian chờ khi lỗi"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:26
msgid "Fetch the signed manifest and check its signature"
msgstr "Tải manifest đã ký và kiểm tra chữ ký"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:508
msgid "First session number"
msgstr "Số phiên đầu tiên"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:211
msgid "Free WANs"
msgstr "WAN còn trống"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:113
msgid "From %s to %s"
msgstr "Từ %s lên %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:562
msgid "Give a client the same WAN back when it returns, if that WAN is free."
