msgid "Asked the router to %s %d session(s)."
msgstr "Đã yêu cầu router %s %d phiên."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:617
msgid "Asked the router to move %s off %s."
msgstr "Đã yêu cầu router chuyển %s khỏi %s."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:132
msgid "Asking the release server..."
msgstr "Đang hỏi máy chủ phát hành..."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:236
msgid "Asking the router what this would change..."
msgstr "Đang hỏi router xem việc này sẽ thay đổi những gì..."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:589
