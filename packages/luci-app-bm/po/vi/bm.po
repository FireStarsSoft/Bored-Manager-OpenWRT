#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:571
msgid "Changing the LAN or either priority takes this instance's rules off before the change and lets the daemon write them again. Bound clients lose their route for a few seconds."
msgstr "Đổi LAN hoặc một trong hai mức ưu tiên sẽ gỡ rule của instance này trước khi thay đổi, rồi để daemon ghi lại. Các máy đang được gán mất đường đi trong vài giây."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:85
msgid "Check for updates"
msgstr "Kiểm tra bản cập nhật"

