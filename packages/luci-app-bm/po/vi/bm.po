msgstr "Máy khách"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:564
msgid "Client rule priority"
msgstr "Ưu tiên rule của máy khách"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:564
msgid "Client rules are written from here upwards. At least %d below the catch-all, which is also the most clients this instance can seat."
msgstr "Rule của máy khách được ghi từ đây trở lên. Phải thấp hơn luật chặn dự phòng ít nhất %d, và đó cũng là số máy tối đa instance này chứa được."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:211
msgid "Clients bound"
msgstr "Máy đã gán"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:211
msgid "Clients seen"
msgstr "Máy đã thấy"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:212
msgid "Clients waiting"
msgstr "Máy đang chờ"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:726
msgid "Clients with no WAN, in the order they asked. A client the pool cannot seat is blocked rather than quietly sent out of whichever WAN the router would have used."
msgstr "Những máy chưa có WAN, theo thứ tự chúng đã hỏi. Máy mà nhóm không xếp được sẽ bị chặn, thay vì lặng lẽ đi ra bằng WAN mà router tình cờ chọn."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:197
