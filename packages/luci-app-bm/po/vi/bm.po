#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:619
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:620
msgid "%d%% used"
msgstr "%d%% đã dùng"

