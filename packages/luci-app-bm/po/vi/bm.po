msgstr "Đã tạo nhóm %s. Các giao diện của nó đang quay số."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:922
msgid "Pool %s is gone."
msgstr "Nhóm %s đã bị xoá."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:814
