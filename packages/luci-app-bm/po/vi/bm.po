msgid "Assignments"
msgstr "Đang gán"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:112
msgid "At %s"
msgstr "Lúc %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:283
msgid "At most %d sessions in one call; %d are ticked."
msgstr "Mỗi lần gọi tối đa %d phiên; đang chọn %d."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:62
