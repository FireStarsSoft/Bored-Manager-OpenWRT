msgid "bm-pppoe-pool is not installed"
msgstr "bm-pppoe-pool chưa được cài"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:256
msgid "bm-pppoe-pool is not installed. Without it this router dials no pools."
msgstr ""
"bm-pppoe-pool chưa được cài. Thiếu nó, router này không quay số pool nào."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:659
msgid ""
"bm-pppoe-pool re-reads netifd, its counters and its firewall zones. The "
"firewall reloads only if something changed."
msgstr ""
"bm-pppoe-pool đọc lại netifd, các bộ đếm và các zone firewall của nó. "
"Firewall chỉ nạp lại nếu có gì đó thay đổi."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:249
msgid ""
"bm-wanbind is installed but is not answering. Check \"logread -e bm-"
"wanbind\"."
msgstr "bm-wanbind đã cài nhưng không trả lời. Xem \"logread -e bm-wanbind\"."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:519
msgid "bm-wanbind is not installed"
msgstr "bm-wanbind chưa được cài"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:250
msgid ""
"bm-wanbind is not installed. Without it there is no WAN Binding on this "
"router: nothing hands a client its own WAN, and nothing keeps a hand-placed "
"binding in force. Install it from Router packages in the app, or with \"apk "
"add bm-wanbind\"."
msgstr ""
"bm-wanbind chưa được cài. Không có nó thì router này không có Gán WAN: không "
"gì cấp cho máy khách một WAN riêng, và không gì giữ cho binding đặt tay có "
"hiệu lực. Cài từ mục Router packages trong ứng dụng, hoặc bằng \"apk add bm-"
"wanbind\"."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:651
msgid ""
"bm-wanbind runs a full pass and puts back every rule it decided and the "
"kernel does not have."
msgstr ""
"bm-wanbind chạy một lượt đầy đủ và đặt lại mọi rule mà nó đã quyết định "
"nhưng kernel không có."

