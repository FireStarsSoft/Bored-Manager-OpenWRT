msgid "Catch-all table"
msgstr "Bảng của luật chặn dự phòng"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:841
msgid ""
"Changes apply to every interface in the pool in one pass. Nothing is written "
"until the check passes and you apply."
msgstr ""
"Thay đổi áp lên mọi giao diện trong nhóm trong một lượt. Chưa có gì được ghi "
"cho tới khi kiểm tra đạt và bạn bấm áp dụng."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:221
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:227
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:246
msgid "Changes since %s"
msgstr "Khác biệt so với %s"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:835
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:1156
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:1563
msgid "Check"
msgstr "Kiểm tra"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:353
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:822
msgid "Check for updates"
msgstr "Kiểm tra bản cập nhật"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:1693
