msgstr "%d dòng cấu hình sẽ thay đổi, trong: %s."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/maintenance.js:247
msgid ""
"%d line(s) differ. A line marked + comes back when this is restored; a line "
"marked - goes away."
msgstr ""
"%d dòng khác nhau. Dòng có dấu + sẽ quay lại khi khôi phục; dòng có dấu - sẽ "
"mất đi."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:153
msgid "%d of %d"
msgstr "%d trên %d"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:243
msgid "%d of no limit"
msgstr "%d, không giới hạn"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:2021
msgid ""
"%d rule(s) the router wrote are not in the kernel, and %d it did not write "
"are."
msgstr ""
"%d rule router đã ghi không có trong kernel, và %d rule nó không ghi thì lại "
"có."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/overview.js:160
msgid ""
"%d rule(s) this router wrote are not in the kernel a moment later. Something "
"else here is removing them - a Bored Manager module older than 3.4.0 does "
"exactly that while the app is connected. The WAN Binding page names them."
msgstr ""
"%d rule router này vừa ghi đã không còn trong kernel một lát sau. Có thứ "
"khác trên router đang gỡ chúng - module Bored Manager cũ hơn 3.4.0 làm đúng "
"như vậy khi ứng dụng đang kết nối. Trang Gán WAN nêu tên chúng."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:434
msgid "%d up, %d error, %d stopped of %d"
msgstr "%d đang lên, %d lỗi, %d đã dừng trên %d"

