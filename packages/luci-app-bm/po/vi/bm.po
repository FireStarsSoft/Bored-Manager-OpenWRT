#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:402
msgid "%d session(s) written to pool %s. They are dialling now."
msgstr "Đã ghi %d phiên vào nhóm %s. Chúng đang quay số."

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:713
