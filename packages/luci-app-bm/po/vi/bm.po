msgid "Create a PPPoE pool"
msgstr "Tạo một nhóm PPPoE"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:338
msgid "Create a pool"
msgstr "Tạo nhóm"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:499
msgid "Create it"
msgstr "Tạo"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:648
msgid "Daemon up"
msgstr "Dịch vụ chạy được"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/updates.js:65
msgid "Data schema"
msgstr "Schema dữ liệu"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/backup.js:136
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/pppoe.js:639
#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:273
msgid "Delete"
msgstr "Xoá"

#: packages/luci-app-bm/htdocs/luci-static/resources/view/bm/wanbind.js:364
