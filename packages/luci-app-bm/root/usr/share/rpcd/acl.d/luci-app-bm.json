{
	"luci-app-bm": {
		"description": "Read and drive the Bored Manager daemons: snapshots, the commit-confirm guard, the updater, the PPPoE Dialer and the WAN bindings. Creating a pool sends account credentials over this connection, and a session with this grant can put any client on any WAN, so grant it to the same people who would be given the router's root password.",
		"read": {
			"ubus": {
				"bm.agent": [
					"info",
					"stats",
					"config_list",
					"config_show",
					"config_diff",
					"config_export",
					"guard_status",
					"update_status",
					"requirements",
					"tune_get",
					"capacity"
				],
				"bm.wanbind": [
					"info",
					"stats",
					"assignments",
					"waiting",
					"bindings",
					"layout",
					"wans",
					"rules",
					"rule_explain",
					"settings_get",
					"verify"
				],
				"bm.pppoe": [
					"info",
					"stats",
					"sessions",
					"carriers",
					"settings_get"
				]
			},
			"uci": [
				"bm_agent",
				"bm_wanbind",
				"bm_pppoe"
			]
		},
		"write": {
			"ubus": {
				"bm.agent": [
					"config_snapshot",
					"config_restore",
					"config_delete",
					"guard_arm",
					"guard_confirm",
					"guard_cancel",
					"update_check",
					"update_apply",
					"update_rollback",
					"install_packages",
					"tune_set"
				],
				"bm.wanbind": [
					"pin",
					"reassign",
					"unassign",
					"release",
					"reconcile",
					"flush",
					"bind",
					"bind_check",
					"bind_many",
					"unbind",
					"unbind_many",
					"instance_check",
					"instance_set",
					"instance_delete",
					"settings_set"
				],
				"bm.pppoe": [
					"action",
					"reconcile",
					"pool_check",
					"pool_add",
					"pool_set",
					"pool_delete",
					"settings_set"
				]
			}
		}
	}
}
