#!/bin/sh /etc/rc.common

# Late, and stopped early. The agent answers questions about the router rather
# than bringing any of it up, so nothing else waits on it - but it does hold a
# ubus object, and a module asking for one that is half torn down gets a worse
# answer than one asking for an object that is plainly gone.
START=95
STOP=10

USE_PROCD=1

# Raw script, strict mode, said out loud rather than left to a shebang: which
# mode ucode defaults to has not always been the same, and a daemon that starts
# printing its own source instead of running it is a confusing way to find out.
AGENT="/usr/share/bm/agentd.uc"

start_service() {
	local enabled

	config_load bm_agent
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	# The schema gate, here rather than only inside the daemon.
	#
	# The daemon refuses to run against data written by a newer release and
	# exits saying so. That refusal is correct, but procd does not look at the
	# exit status - the third respawn field is a retry limit and it is 0, which
	# means unlimited - so an instance registered here is restarted every five
	# seconds forever, and the one line that explains why fills the log instead
	# of standing in it.
	#
	# `bmctl schema` is the same check the daemon makes, run before anything is
	# registered. A router in that state then has no instance to respawn, one
	# line in the log, and a service that starts normally as soon as the right
	# release is back.
	if ! /usr/sbin/bmctl schema >/dev/null 2>&1; then
		logger -t bm-agent -p daemon.err "the data on disk is written at a schema this build does not understand; not starting - run 'bmctl schema' to see why"
		return 0
	fi

	procd_open_instance bm-agent
	procd_set_param command /usr/bin/ucode -R -S "$AGENT"
	# Unlimited restarts, five seconds apart. The agent is what the module
	# talks to, so a crash that stops being retried is a router that silently
	# drops back to the compatibility path and stays there.
	procd_set_param respawn 3600 5 0
	# procd forwards stderr to syslog, which is where every warn() below ends
	# up - one log, read with logread, like everything else on the router.
	procd_set_param stderr 1
	procd_set_param file /etc/config/bm_agent
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "bm_agent"
}
