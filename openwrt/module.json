{
  "apiVersion": 2,
  "id": "openwrt",
  "name": "OpenWRT",
  "version": "3.4.0",
  "description": "Manage an OpenWRT router without its web UI: live dashboard, the PPPoE Dialer, and WAN Binding - one-to-one LAN device to WAN binding, hand-placed address-to-port bindings and a monitor that explains every source-routed address, all owned by the router's own binding service.",
  "author": "Bored Manager",
  "minAppVersion": "0.7.0",
  "defaultEnabled": false,
  "entries": {
    "main": "main/index.ts"
  },
  "pages": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "icon": "Gauge",
      "order": 57
    },
    {
      "id": "connection",
      "label": "Connection",
      "icon": "Cable",
      "order": 58
    },
    {
      "id": "settings",
      "label": "Module settings",
      "icon": "Settings2",
      "order": 59
    }
  ],
  "widgets": [
    {
      "id": "summary",
      "label": "OpenWRT",
      "defaultEnabled": false,
      "order": 77
    }
  ],
  "streams": [
    {
      "event": "capabilities",
      "kind": "latest"
    },
    {
      "event": "ui",
      "kind": "latest"
    },
    {
      "event": "overview",
      "kind": "latest"
    },
    {
      "event": "series",
      "kind": "series"
    },
    {
      "event": "pppoe",
      "kind": "latest"
    },
    {
      "event": "binding",
      "kind": "latest"
    },
    {
      "event": "direct",
      "kind": "latest"
    },
    {
      "event": "monitor",
      "kind": "latest"
    },
    {
      "event": "jobs",
      "kind": "latest"
    }
  ],
  "methods": [
    "sweepNow",
    "selectOptions",
    "hintsSet",
    "deviceRows",
    "setupCheck",
    "setupApply",
    "installHint",
    "pppoePools",
    "pppoeRows",
    "pppoeLegacyRows",
    "pppoeCarriers",
    "poolCreateCheck",
    "poolCreateApply",
    "poolSetCheck",
    "poolSetApply",
    "poolDelete",
    "pppoePoolAction",
    "pppoeConnAction",
    "pppoeSettingsGet",
    "pppoeSettingsCheck",
    "pppoeSettingsApply",
    "bindingCheck",
    "bindingApply",
    "bindingRows",
    "bindingWaitingRows",
    "bindingEventRows",
    "eventRows",
    "bindingStart",
    "bindingStop",
    "bindingUpdate",
    "bindingDelete",
    "bindingUnassign",
    "bindingReassign",
    "bindingPin",
    "directRows",
    "bindingSettingsGet",
    "bindingSettingsCheck",
    "bindingSettingsApply",
    "directCheck",
    "directApply",
    "directUpdate",
    "directEnable",
    "directDisable",
    "directDelete",
    "scanRows",
    "scanNow",
    "rulesEffective",
    "rulesCheck",
    "rulesApply",
    "rulesReset",
    "limitsEffective",
    "limitsCheck",
    "limitsApply",
    "jobCancel",
    "jobsClear",
    "agentRows",
    "agentInstallCheck",
    "agentInstallApply",
    "agentUninstallCheck",
    "agentUninstallApply"
  ],
  "storage": {
    "config": {
      "maxKB": 512
    },
    "hostData": {
      "maxKB": 512
    },
    "history": {
      "streams": [
        "openwrt"
      ],
      "maxMB": 32
    }
  },
  "fastInterval": "openwrt",
  "slowInterval": "openwrt"
}
