# The module folder is hashed byte for byte by the app that installs it
# (server/services/modules-host.ts, scripts/modules-lock.mjs in Bored Manager).
# A CRLF checkout would hash differently from the release zip, so the host would
# call the module 'modified' and refuse to activate it. Keep it LF everywhere.
openwrt/** text eol=lf

# Tooling that has to run on Linux CI unchanged.
*.mjs text eol=lf
*.sh  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
